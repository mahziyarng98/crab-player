# Maintainer: Crab Player authors <maintainers@example.invalid>
pkgname=crab-player
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast native media player built with Rust, egui and libmpv"
arch=('x86_64' 'aarch64')
url="https://github.com/your-org/crab-player"
license=('MIT')
# mpv provides libmpv.so.2. Codec support comes from FFmpeg: Arch's `ffmpeg`
# is the full build (all decoders, dav1d for AV1, libvpx, …), so "plays
# everything" means "everything the installed ffmpeg decodes". The rest is
# what the binary links or loads.
depends=('mpv' 'ffmpeg' 'gcc-libs' 'glibc' 'libglvnd' 'wayland' 'libxkbcommon' 'hicolor-icon-theme')
makedepends=('cargo')
optdepends=(
  'xdg-desktop-portal: native file dialogs'
  'xdg-desktop-portal-gtk: a file chooser for the portal on non-GNOME desktops'
  'libva: VA-API hardware decoding'
  'libva-mesa-driver: VA-API hardware decoding on AMD (H.264, HEVC, VP9, AV1 on recent GPUs)'
  'intel-media-driver: VA-API hardware decoding on Intel Broadwell and newer'
  'libva-intel-driver: VA-API hardware decoding on older Intel GPUs'
  'nvidia-utils: NVDEC hardware decoding on NVIDIA'
  'libxcursor: cursor themes on X11'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/your-org/$pkgname/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="${CARGO_HOME:-$srcdir/cargo-home}"
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="${CARGO_HOME:-$srcdir/cargo-home}"
  cargo test --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 packaging/crab-player.desktop \
    "$pkgdir/usr/share/applications/crab-player.desktop"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/hicolor/${size}x${size}/apps/crab-player.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/crab-player.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
